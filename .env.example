# Copiar a .env y completar (nunca commitear .env)

# Desarrollo local: True | Producción: False
DJANGO_DEBUG=True

# Obligatorio en producción (generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=

# Separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,software.kenkomed.cl,www.software.kenkomed.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://software.kenkomed.cl,https://www.software.kenkomed.cl

# Base de datos
DB_HOST=db
DB_NAME=my_database
DB_USER=django_user
DB_PASSWORD=
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Correo (Gmail u otro SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Producción con HTTPS detrás de proxy (Nginx). En Docker local sin TLS: False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

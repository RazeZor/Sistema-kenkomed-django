# Copiar a .env y completar (nunca commitear .env)

# Desarrollo local: True | Producción: False
DJANGO_DEBUG=False

# Obligatorio en producción (generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# ⚠️ NUNCA reutilizar la clave de desarrollo ni commitear este archivo con valor real
DJANGO_SECRET_KEY=

# Separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,software.kenkomed.cl,www.software.kenkomed.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://software.kenkomed.cl,https://www.software.kenkomed.cl

# Base de datos
DB_HOST=db
DB_NAME=my_database
DB_USER=django_user
# ⚠️ Usar una contraseña larga y aleatoria (>24 caracteres). Ejemplo: openssl rand -base64 32
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Resend API (HTTP API - Puerto 443, inmune a bloqueos VPS)
RESEND_API_KEY=re_your_api_key_here

RESEND_FROM_EMAIL=KenkoMed <notificaciones@kenkomed.cl>





# Correo (Gmail u otro SMTP de respaldo)

EMAIL_BACKEND=ProyectoMainAPP.resend_backend.ResendEmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=tu_correo@gmail.com
# ⚠️ App Password de Gmail (generar en myaccount.google.com/apppasswords)
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KenkoMed <notificaciones@kenkomed.cl>
EMAIL_BCC_SYSTEM=tu_correo@gmail.com


# Producción con HTTPS detrás de proxy (Nginx). En Docker local sin TLS: False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
